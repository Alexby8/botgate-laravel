{
    "name": "botgate/laravel",
    "description": "Laravel integration for the BotGate PHP SDK - Telegram Bot API proxy",
    "type": "library",
    "license": "MIT",
    "homepage": "https://bot-gate.ru/",
    "keywords": ["botgate", "laravel", "telegram", "bot", "webhook"],
    "authors": [
        {
            "name": "BotGate",
            "homepage": "https://bot-gate.ru/"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "botgate/sdk": "^1.0",
        "illuminate/contracts": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "BotGate\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BotGate\\Laravel\\BotGateServiceProvider"
            ],
            "aliases": {
                "BotGate": "BotGate\\Laravel\\Facades\\BotGate"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "format": "pint"
    }
}
